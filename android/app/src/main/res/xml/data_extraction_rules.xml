<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep SafeOne's data (contacts, medical info, PIN hashes,
     recordings) out of cloud backups AND phone-to-phone transfers. Keystore
     keys never transfer, so restored secure-storage values can't be decrypted
     anyway, which used to break the PIN after a restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
